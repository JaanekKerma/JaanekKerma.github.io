---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sitePath } from '../../utils/paths';

const email = 'jaanek.kerma@gmail.com';
const phoneDisplay = '076 212 69 22';
const phoneLink = '+46762126922';
const fallbackSuccess = new URL(sitePath('contact/?submitted=1'), Astro.site).href;
---
<SiteLayout
  title="Let's talk — Jaanek Kerma"
  description="Contact Jaanek Kerma about game programming, software development and testing. Professional email, telephone, GitHub, LinkedIn and a message form."
  navItems={[
    { label: 'Top', id: 'contact-intro' },
    { label: 'Contact', id: 'contact-panels' },
  ]}
>
  <section id="contact-intro" class="contact-page-hero shell" aria-labelledby="contact-page-title">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={sitePath('')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span>
    </nav>
    <div class="contact-page-intro">
      <span class="section-eyebrow">04 / CONTACT</span>
      <h1 id="contact-page-title">Let's build<br /><em>something good.</em></h1>
      <p>Have an opportunity, a technical challenge, or an interesting idea? I'm interested in programming roles across game development, general software and testing.</p>
    </div>
  </section>

  <section id="contact-panels" class="shell contact-page-grid" aria-label="Contact details and message form">
    <div id="contact-details" class="contact-details">
      <div class="contact-details-intro">
        <span class="section-eyebrow">GET IN TOUCH / DIRECT</span>
        <h2>Find me here<span class="contact-dot">.</span></h2>
        <p>Prefer to reach out directly? You can contact me through email or phone, or connect through my professional profiles.</p>
      </div>
      <div class="contact-methods">
        <div class="contact-method">
          <span class="contact-method-index">01 / EMAIL</span>
          <a href={'mailto:' + email}>{email}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-method">
          <span class="contact-method-index">02 / PHONE</span>
          <a href={'tel:' + phoneLink}>{phoneDisplay}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-method">
          <span class="contact-method-index">03 / GITHUB</span>
          <a href="https://github.com/Ruscemp" target="_blank" rel="noopener noreferrer">github.com/Ruscemp<span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-method">
          <span class="contact-method-index">04 / LINKEDIN</span>
          <a href="https://www.linkedin.com/in/jaanek-kerma-257383190/" target="_blank" rel="noopener noreferrer">LinkedIn profile<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="contact-location-line"><span class="availability-dot" aria-hidden="true"></span> Based in Sweden · Open to professional opportunities</p>
    </div>

    <div id="send-message" class="contact-form-panel">
      <div class="form-panel-topline"><span>MESSAGE / 001</span><span class="online-dot" aria-hidden="true"></span></div>
      <h2>Send a message.</h2>
      <p class="contact-form-description">Use this form to send a message to my email inbox. You can also reach me directly using the details beside the form.</p>
      <form
        id="portfolio-contact-form"
        class="contact-form"
        action={'https://formsubmit.co/' + email}
        data-ajax-endpoint={'https://formsubmit.co/ajax/' + email}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Portfolio inquiry — Jaanek Kerma" />
        <input type="hidden" name="_next" value={fallbackSuccess} />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="contact-honeypot" aria-hidden="true" />
        <div class="contact-field-row">
          <label class="contact-field" for="contact-name">
            <span>Your name <b>*</b></span>
            <input id="contact-name" name="name" type="text" placeholder="Your name" autocomplete="name" maxlength="120" required />
          </label>
          <label class="contact-field" for="contact-email">
            <span>Email address <b>*</b></span>
            <input id="contact-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" maxlength="254" required />
          </label>
        </div>
        <label class="contact-field" for="contact-subject">
          <span>Subject <b>*</b></span>
          <input id="contact-subject" name="subject" type="text" placeholder="What would you like to discuss?" maxlength="180" required />
        </label>
        <label class="contact-field" for="contact-message">
          <span>Your message <b>*</b></span>
          <textarea id="contact-message" name="message" rows="7" placeholder="Tell me about your project, opportunity or question…" minlength="10" maxlength="10000" required></textarea>
        </label>
        <div class="contact-form-footer">
          <button class="button button-primary contact-send" type="submit">
            Send message <span aria-hidden="true">↗</span>
          </button>
          <span class="contact-form-note">* Required fields</span>
        </div>
        <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
      </form>
      <p class="form-privacy">Form submissions are processed by <a href="https://formsubmit.co/" target="_blank" rel="noopener noreferrer">FormSubmit</a> for email delivery. Please avoid sending passwords or other sensitive information.</p>
    </div>
  </section>
  <section class="shell contact-page-bottom"><a class="text-link" href={sitePath('projects/')}>← Back to projects</a></section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#portfolio-contact-form');
    const message = form?.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (message && new URL(window.location.href).searchParams.get('submitted') === '1') {
      message.hidden = false;
      message.dataset.state = 'success';
      message.textContent = 'Your message was submitted. Thank you for reaching out.';
    }

    form?.addEventListener('submit', async (event) => {
      if (!form || !message || !submitButton || !form.reportValidity()) return;
      event.preventDefault();
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      message.hidden = false;
      message.dataset.state = 'pending';
      message.textContent = 'Submitting your message…';

      try {
        const endpoint = form.dataset.ajaxEndpoint;
        if (!endpoint) throw new Error('Missing message endpoint');
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        if (!response.ok || (result.success !== true && result.success !== 'true')) {
          throw new Error('The message was not accepted');
        }
        form.reset();
        message.dataset.state = 'success';
        message.textContent = 'Your message was submitted successfully. Thank you for reaching out!';
      } catch {
        message.dataset.state = 'error';
        message.textContent = 'Submission could not be confirmed. Please contact me directly using the email address on this page.';
      } finally {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
      }
    });
  </script>
</SiteLayout>
