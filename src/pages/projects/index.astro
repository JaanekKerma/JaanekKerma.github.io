---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
const hasMultipleCategories = new Set(projects.map((project) => project.category)).size > 1;
---
<SiteLayout
  title="Projects — Jaanek Kerma"
  description="Game development and software engineering projects by Jaanek Kerma, with details about technologies, systems, and outcomes."
  navItems={[{ label: 'Projects', id: 'projects-overview' }, { label: 'Project Gallery', id: 'projects-gallery' }]}
>
  <section id="projects-overview" class="listing-hero shell">
    <div class="section-eyebrow">PORTFOLIO / ALL PROJECTS</div>
    <h1>Selected <em>work.</em></h1>
    <p>Explore selected game projects and the engineering decisions behind them. Open a project to learn how it was made.</p>
    <div class="project-filter-bar">
      <span class="project-counter">01—{String(projects.length).padStart(2, '0')} / PROJECT INDEX</span>
      {hasMultipleCategories && (
        <div class="project-filters" data-filter-controls hidden aria-label="Filter projects">
          <button type="button" class="filter-button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="filter-button" data-filter="game" aria-pressed="false">Games</button>
          <button type="button" class="filter-button" data-filter="software" aria-pressed="false">Software</button>
        </div>
      )}
    </div>
  </section>
  <section id="projects-gallery" class="shell listing-section" aria-label="Projects">
    <div class="featured-grid projects-grid">
      {projects.map((project, index) => (
        <div data-category={project.category} class="project-grid-item"><ProjectCard project={project} index={index} /></div>
      ))}
    </div>
    <p class="filter-empty" data-filter-empty hidden>No projects match this filter.</p>
  </section>
  <script>
    const controls = document.querySelector<HTMLElement>('[data-filter-controls]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-category]')];
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    if (controls) {
      controls.hidden = false;
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const active = button.dataset.filter ?? 'all';
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          let shown = 0;
          cards.forEach((card) => {
            const visible = active === 'all' || card.dataset.category === active;
            card.hidden = !visible;
            if (visible) shown++;
          });
          if (empty) empty.hidden = shown > 0;
        });
      });
    }
  </script>
</SiteLayout>
