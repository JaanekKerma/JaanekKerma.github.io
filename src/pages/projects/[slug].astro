---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, type Project } from '../../data/projects';
import { sitePath } from '../../utils/paths';

interface Props {
  project: Project;
}

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const related = projects.filter((item) => item.slug !== project.slug).slice(0, 2);
---
<SiteLayout
  title={project.title + ' — Jaanek Kerma'}
  description={project.summary}
  type="article"
  navItems={[
    { label: 'Project', id: 'project-top' },
    { label: 'Overview', id: 'project-overview' },
    { label: 'Systems', id: 'project-systems' },
    ...(project.gallery?.length ? [{ label: 'Gallery', id: 'project-media' }] : []),
  ]}
>
  <article>
    <header id="project-top" class="detail-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={sitePath("")}>Home</a><span aria-hidden="true">/</span><a href={sitePath("projects/")}>Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.title}</span>
      </nav>
      <div class="detail-headline">
        <div>
          <div class="section-eyebrow">{project.eyebrow}</div>
          <h1>{project.title}<span class="detail-period">.</span></h1>
          <p class="detail-lead">{project.lead}</p>
          <div class="tag-row tag-row--detail">{project.stack.map((tech) => <span class="tag">{tech}</span>)}</div>
        </div>
        <div class="detail-right-marker" aria-hidden="true">PROJECT<br />DETAILS <span>↗</span></div>
      </div>
      <div class="detail-visual">
        {project.coverImage ? <img class="detail-hero-image" src={sitePath(project.coverImage)} alt={project.coverAlt ?? project.title} decoding="async" /> : <ProjectVisual variant={project.visual} large />}
        <div class="detail-image-caption"><span>{project.coverImage ? 'PROJECT MEDIA' : 'ILLUSTRATIVE VISUAL STUDY'}</span><span>{project.category === 'game' ? 'GAME DEVELOPMENT' : 'SOFTWARE ENGINEERING'}</span></div>
      </div>
    </header>

    <section class="detail-meta-strip">
      <div class="shell detail-meta-grid">
        <div><span>MY ROLE / PROJECT TYPE</span><strong>{project.role}</strong>{project.teamSize && <small>{project.teamSize === 1 ? 'Solo project' : `Team of ${project.teamSize}`}</small>}</div>
        <div><span>CONTEXT</span><strong>{project.timeframe}</strong></div>
        <div><span>PRIMARY TOOLS</span><strong>{project.stack.slice(0, 3).join(' · ')}</strong></div>
      </div>
    </section>

    <div class="shell detail-content">
      <div class="detail-main">
        <section id="project-overview" class="detail-section">
          <span class="section-eyebrow">01 / OVERVIEW</span>
          <h2>The idea.</h2>
          <p>{project.context}</p>
        </section>
        <section class="detail-section">
          <span class="section-eyebrow">02 / ENGINEERING CHALLENGE</span>
          <h2>The problem to solve.</h2>
          <p>{project.challenge}</p>
        </section>
        <section id="project-systems" class="detail-section">
          <span class="section-eyebrow">03 / IMPLEMENTATION</span>
          <h2>Systems & decisions.</h2>
          <div class="system-list">
            {project.systems.map((system, index) => (
              <div class="system-row">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{system.title}</h3><p>{system.description}</p></div>
              </div>
            ))}
          </div>
        </section>
        {project.projectBackground && (
          <section class="detail-section">
            <span class="section-eyebrow">PROJECT CONTEXT / DESIGN INTENT</span>
            <h2>Project background.</h2>
            {project.projectBackground.subtitle && <p class="original-project-subtitle">{project.projectBackground.subtitle}</p>}
            {project.projectBackground.concept && (
              <div class="original-project-text">
                <h3>Concept</h3>
                <p>{project.projectBackground.concept}</p>
              </div>
            )}
            {project.projectBackground.idea && (
              <div class="original-project-text">
                <h3>The idea</h3>
                <p>{project.projectBackground.idea}</p>
              </div>
            )}
            {project.projectBackground.myRole && (
              <div class="original-project-text">
                <h3>My role</h3>
                <p>{project.projectBackground.myRole}</p>
              </div>
            )}
          </section>
        )}
        {project.gallery && project.gallery.length > 0 && (
          <section id="project-media" class="detail-section project-gallery-section">
            <span class="section-eyebrow">04 / PROJECT MEDIA</span>
            <h2>Implementation gallery.</h2>
            <p>Screenshots and explanations from the project's development.</p>
            <div class="case-gallery">
              {project.gallery.map((image) => (
                <figure class="case-gallery-item">
                  <a href={sitePath(image.url)} target="_blank" rel="noopener noreferrer" aria-label={'Open full image: ' + image.title}>
                    <img src={sitePath(image.url)} alt={image.alt} loading="lazy" decoding="async" />
                  </a>
                  <figcaption>
                    <strong>{image.title}</strong>
                    {image.description && <p>{image.description}</p>}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
        <section class="detail-section">
          <span class="section-eyebrow">05 / ADDITIONAL NOTES</span>
          <h2>Further details.</h2>
          <ul class="detail-notes">
            {project.notes.map((note) => <li>{note}</li>)}
          </ul>
        </section>
      </div>
      <aside class="detail-aside" aria-label="Project links and summary">
        <div class="detail-sticky">
          {project.links.length > 0 && (
            <>
              <span class="aside-label">PLAY & DOWNLOAD</span>
              <div class="detail-actions">
                {project.links.map((link) => (
                  <a class={link.primary ? 'button button-primary' : 'button button-outline'} href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>
                ))}
              </div>
              <div class="detail-aside-rule"></div>
            </>
          )}
          <span class="aside-label">PROJECT NOTE</span>
          <p class="aside-note">Project highlights, screenshots, and development notes are presented here. Play or download links appear when publicly accessible.</p>
          <a class="text-link" href={sitePath("projects/")}>← All projects</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="related-section">
    <div class="shell">
      <div class="section-heading"><div><div class="section-eyebrow">KEEP EXPLORING</div><h2>Other <em>work.</em></h2></div><a class="text-link" href={sitePath("projects/")}>Browse all projects ↗</a></div>
      <div class="featured-grid related-grid">{related.map((item, index) => <ProjectCard project={item} index={index} />)}</div>
    </div>
  </section>
</SiteLayout>
