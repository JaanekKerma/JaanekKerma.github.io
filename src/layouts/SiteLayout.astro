---
import '../styles/global.css';
import { sitePath } from '../utils/paths';
import { projects } from '../data/projects';

interface NavItem { label: string; id: string; }
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  navItems?: NavItem[];
}
const { title, description, type = 'website', navItems = [] } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const onProjects = Astro.url.pathname.startsWith(sitePath('projects/'));
const onContact = Astro.url.pathname.startsWith(sitePath('contact/'));
const onHome = Astro.url.pathname === sitePath('');
const isPreview = import.meta.env.BASE_URL.includes('/preview/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101318" />
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl.href} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    {isPreview && <div class="preview-banner" role="note"><strong>DEVELOPMENT PREVIEW</strong><span>Design iteration 01 — not the final portfolio</span></div>}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={sitePath("")} aria-label="Jaanek Kerma — home">
          <span class="brand-symbol">J<span>K</span><span class="brand-point">.</span></span>
          <span class="brand-copy"><strong>JAANEK KERMA</strong><small>GAME & SOFTWARE DEVELOPMENT</small></span>
        </a>
        <div class="header-actions">
          {navItems.length > 0 && (
            <nav class="main-nav" aria-label="Sections of this page">
              {navItems.map((item) => <a href={'#' + item.id}>{item.label}</a>)}
            </nav>
          )}
          <button class="menu-trigger" type="button" data-menu-trigger aria-controls="site-drawer" aria-expanded="false" aria-label="Open navigation menu">
            <span class="menu-trigger-copy">Menu</span>
            <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
          </button>
        </div>
      </div>
    </header>
    <div class="site-drawer" id="site-drawer" data-site-drawer hidden>
      <button class="drawer-backdrop" type="button" data-drawer-close tabindex="-1" aria-label="Close navigation menu"></button>
      <aside class="drawer-panel" data-drawer-panel role="dialog" aria-modal="true" aria-label="Explore the portfolio">
        <div class="drawer-head">
          <span class="section-eyebrow">JAANEK KERMA / NAVIGATION</span>
          <button class="drawer-close" type="button" data-drawer-close aria-label="Close navigation menu"><span aria-hidden="true">×</span> Close</button>
        </div>
        <nav class="drawer-navigation" aria-label="Expanded navigation">
          <div class="drawer-group-label">EXPLORE / PORTFOLIO</div>
          <div class="drawer-nav-branch">
            <div class="drawer-branch-header">
              <button
                type="button"
                class="drawer-submenu-toggle"
                data-submenu-toggle
                data-submenu-label="Homepage sections"
                aria-controls="drawer-home-sections"
                aria-expanded="false"
                aria-label="Expand Homepage sections"
              ><span class="drawer-chevron" aria-hidden="true"></span></button>
              <a class="drawer-primary-link" href={sitePath("")} aria-current={onHome ? 'page' : undefined}>
                <span>Homepage</span><span aria-hidden="true">↗</span>
              </a>
            </div>
            <div id="drawer-home-sections" class="drawer-submenu" role="group" aria-label="Homepage sections" hidden>
              <a href={sitePath("#intro")}>Introduction</a>
              <a href={sitePath("#work")}>Featured projects</a>
              <a href={sitePath("#expertise")}>Expertise</a>
              <a href={sitePath("#about")}>About</a>
              <a href={sitePath("#connect")}>Let's connect</a>
            </div>
          </div>
          <div class="drawer-nav-branch">
            <div class="drawer-branch-header">
              <button
                type="button"
                class="drawer-submenu-toggle"
                data-submenu-toggle
                data-submenu-label="Project pages"
                aria-controls="drawer-project-pages"
                aria-expanded="false"
                aria-label="Expand Project pages"
              ><span class="drawer-chevron" aria-hidden="true"></span></button>
              <a class="drawer-primary-link" href={sitePath("projects/")} aria-current={onProjects ? 'page' : undefined}>
                <span>All projects</span><span aria-hidden="true">↗</span>
              </a>
            </div>
            <div id="drawer-project-pages" class="drawer-submenu drawer-project-list" role="group" aria-label="Individual projects" hidden>
              {projects.map((project, index) => (
                <a href={sitePath("projects/" + project.slug + "/")}>
                  <span class="drawer-project-index">{String(index + 1).padStart(2, "0")}</span>
                  <span>{project.title}</span>
                  <span class="drawer-project-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
          <a class="drawer-primary-link drawer-standalone-link" href={sitePath("contact/")} aria-current={onContact ? 'page' : undefined}>
            <span>Let's talk / Contact</span><span aria-hidden="true">↗</span>
          </a>
        </nav>
        <div class="drawer-foot">
          <span>GAMES, SYSTEMS & SOFTWARE</span>
          <a href={sitePath("contact/")}>Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="footer-mark" href={sitePath("")} aria-label="Back to homepage">JK<span>.</span></a>
        <div class="footer-identity"><strong>Jaanek Kerma</strong><span>Game development & software engineering</span></div>
        <div class="footer-socials" aria-label="Professional profiles">
          <a href="https://github.com/Ruscemp" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/jaanek-kerma-257383190/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href={sitePath("contact/")}>Contact ↗</a>
        </div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Jaanek Kerma</span><span>Built with Astro · Hosted on GitHub Pages</span></div>
    </footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
      const drawer = document.querySelector<HTMLElement>('[data-site-drawer]');
      const panel = document.querySelector<HTMLElement>('[data-drawer-panel]');
      let previousFocus: HTMLElement | null = null;
      const focusableItems = () => panel
        ? Array.from(panel.querySelectorAll<HTMLElement>('a[href],button:not([disabled]):not([tabindex="-1"])'))
            .filter((element) => element.getClientRects().length > 0)
        : [];

      const submenuToggles = Array.from(panel?.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]') ?? []);
      const setSubmenuOpen = (button: HTMLButtonElement, open: boolean) => {
        const id = button.getAttribute('aria-controls');
        const content = id ? document.getElementById(id) : null;
        if (!content) return;
        content.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', (open ? 'Collapse ' : 'Expand ') + (button.dataset.submenuLabel ?? 'submenu'));
      };
      submenuToggles.forEach((button) => {
        button.addEventListener('click', () => {
          setSubmenuOpen(button, button.getAttribute('aria-expanded') !== 'true');
        });
      });

      // Lock the page at its current scroll position while the drawer is open.
      // Restoring focus with preventScroll avoids a surprise jump on backdrop click.
      let savedScrollY = 0;
      const closeDrawer = () => {
        if (!drawer || drawer.hidden) return;
        drawer.hidden = true;
        submenuToggles.forEach((button) => setSubmenuOpen(button, false));
        document.body.classList.remove('drawer-is-open');
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.width = '';
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation menu');
        // The site normally uses smooth scrolling for anchors, but closing the
        // overlay must restore the exact scroll position instantly.
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        window.scrollTo(0, savedScrollY);
        root.style.scrollBehavior = previousScrollBehavior;
        const destination = previousFocus?.isConnected ? previousFocus : menuButton;
        destination?.focus({ preventScroll: true });
      };

      const openDrawer = () => {
        if (!drawer || !drawer.hidden) return;
        savedScrollY = window.scrollY;
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        document.body.style.top = '-' + savedScrollY + 'px';
        document.body.style.left = '0';
        document.body.style.width = '100%';
        document.body.style.position = 'fixed';
        document.body.classList.add('drawer-is-open');
        drawer.hidden = false;
        menuButton?.setAttribute('aria-expanded', 'true');
        menuButton?.setAttribute('aria-label', 'Close navigation menu');
        panel?.querySelector<HTMLElement>('.drawer-close')?.focus({ preventScroll: true });
      };

      menuButton?.addEventListener('click', () => drawer?.hidden ? openDrawer() : closeDrawer());
      drawer?.querySelectorAll<HTMLElement>('[data-drawer-close]').forEach(button => button.addEventListener('click', closeDrawer));
      drawer?.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => link.addEventListener('click', closeDrawer));
      document.addEventListener('keydown', (event) => {
        if (!drawer || drawer.hidden) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeDrawer();
          return;
        }
        if (event.key !== 'Tab') return;
        const focusables = focusableItems();
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      window.addEventListener('popstate', closeDrawer);
    </script>
  </body>
</html>
