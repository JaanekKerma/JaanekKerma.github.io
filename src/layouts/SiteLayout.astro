---
import '../styles/global.css';
import { sitePath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
}
const { title, description, type = 'website' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const onProjects = Astro.url.pathname.startsWith(sitePath('projects/'));
const isPreview = import.meta.env.BASE_URL.includes('/preview/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101318" />
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl.href} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    {isPreview && <div class="preview-banner" role="note"><strong>DEVELOPMENT PREVIEW</strong><span>Design iteration 01 — not the final portfolio</span></div>}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={sitePath("")} aria-label="Jaanek Kerma — home">
          <span class="brand-symbol">J<span>K</span><span class="brand-point">.</span></span>
          <span class="brand-copy"><strong>JAANEK KERMA</strong><small>GAME & SOFTWARE DEVELOPMENT</small></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={sitePath("projects/")} aria-current={onProjects ? 'page' : undefined}>Projects</a>
          <a href={sitePath("#expertise")}>Expertise</a>
          <a href={sitePath("#about")}>About</a>
          <a class="nav-contact" href="mailto:jaanek.kerma@gmail.com">Let's talk <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="footer-mark" href={sitePath("")} aria-label="Back to homepage">JK<span>.</span></a>
        <div class="footer-identity"><strong>Jaanek Kerma</strong><span>Game development & software engineering</span></div>
        <div class="footer-socials" aria-label="Professional profiles">
          <a href="https://github.com/Ruscemp" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/jaanek-kerma-257383190/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="mailto:jaanek.kerma@gmail.com">Email ↗</a>
        </div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Jaanek Kerma</span><span>Built with Astro · Hosted on GitHub Pages</span></div>
    </footer>
  </body>
</html>
