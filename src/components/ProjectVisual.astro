---
import type { ProjectVisual as VisualType } from '../data/projects';

interface Props {
  variant: VisualType;
  large?: boolean;
}
const { variant, large = false } = Astro.props;
const labels: Record<VisualType, string> = {
  fortune: 'Abstract diagram of number entities flowing through arithmetic gates',
  arena: 'Abstract tactical arena diagram with targeting reticle',
  tictactoe: 'Stylized tic-tac-toe board floating in a starfield',
  takstrid: 'Illustrative sound-wave interface describing audio-first navigation',
  farmlore: 'Stylized pixel-art farm and dark forest scene with player and monster',
  frog: 'Stylized ninja frog jumping between forest platforms',
};
---
<div class={'project-visual visual-' + variant + (large ? ' visual-large' : '')} role="img" aria-label={labels[variant]}>
  <span class="visual-corner visual-corner--tl" aria-hidden="true"></span>
  <span class="visual-corner visual-corner--br" aria-hidden="true"></span>
  {variant === 'fortune' && (
    <>
      <span class="visual-topline" aria-hidden="true">FG / CORE_SYSTEM</span>
      <svg class="visual-svg fortune-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <circle cx="320" cy="205" r="133" stroke="#98A9FF" stroke-opacity=".20" />
        <circle cx="320" cy="205" r="112" stroke="#98A9FF" stroke-opacity=".27" stroke-dasharray="2 10" />
        <circle cx="320" cy="205" r="89" stroke="#A5B4FF" stroke-opacity=".45" />
        <circle cx="320" cy="205" r="60" stroke="#C5D4FF" stroke-opacity=".40" />
        <path d="M32 294C129 294 121 107 229 107S309 299 402 299 492 165 608 165" stroke="#A8A4FD" stroke-width="2" stroke-opacity=".68"/>
        <path d="M30 158C116 158 178 248 240 248S355 140 421 140 519 258 612 258" stroke="#B1F5D1" stroke-width="2" stroke-opacity=".50"/>
        <path d="M229 107v75M402 261v75M470 140v79" stroke="#C8D0FB" stroke-dasharray="4 7" stroke-opacity=".4"/>
        <g fill="#151C38" stroke="#BBF2D3" stroke-width="2">
          <rect x="205" y="85" width="48" height="44" rx="10"/>
          <rect x="378" y="275" width="48" height="44" rx="10"/>
        </g>
        <text x="229" y="113" font-size="22" fill="#E8FFF0" text-anchor="middle" font-family="monospace">+1</text>
        <text x="402" y="302" font-size="22" fill="#E8FFF0" text-anchor="middle" font-family="monospace">×2</text>
        <circle cx="320" cy="205" r="35" fill="#13192E" stroke="#D4EEFC" stroke-width="2"/>
        <circle cx="320" cy="205" r="28" fill="#151F38"/>
        <text x="320" y="216" font-size="42" font-weight="700" fill="#ECF8FF" text-anchor="middle" font-family="monospace">7</text>
        <g fill="#C5A6FD">
          <circle cx="81" cy="255" r="6"/><circle cx="504" cy="165" r="5"/>
          <circle cx="526" cy="258" r="5"/>
        </g>
        <g fill="#B2F4D3"><circle cx="82" cy="158" r="5"/><circle cx="586" cy="258" r="6"/></g>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">TRANSFORM → MATCH → RESTORE</span>
    </>
  )}
  {variant === 'arena' && (
    <>
      <span class="visual-topline" aria-hidden="true">SZ / ARENA_01</span>
      <svg class="visual-svg arena-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <path d="M0 334L268 162 640 312M0 264L268 162 640 254M86 400l182-238M270 400l-2-238M461 400L268 162" stroke="#7F9CB6" stroke-width="1.5" stroke-opacity=".35"/>
        <path d="M0 96h640M0 132h640M0 168h640M0 204h640" stroke="#6589AD" stroke-opacity=".13"/>
        <path d="M56 315V184l101-54 98 42v123l-102 51-97-31ZM400 302V153l93-48 96 38v140l-94 48-95-29Z" fill="#223346" stroke="#8DAFCC" stroke-opacity=".75" stroke-width="2"/>
        <path d="M96 201l59-33 56 25v89l-56 29-59-19zM443 173l50-26 52 20v98l-51 26-51-20z" stroke="#A8C5D9" stroke-opacity=".4"/>
        <circle cx="320" cy="212" r="67" stroke="#D5EF9D" stroke-width="1.7" stroke-opacity=".63"/>
        <circle cx="320" cy="212" r="15" stroke="#D5EF9D" stroke-width="1.8"/>
        <path d="M320 123v57m0 65v59m-88-92h55m65 0h55" stroke="#D5EF9D" stroke-width="2"/>
        <path d="M130 107h76m-76 0v45M506 83h-72m72 0v45" stroke="#C4D8EE" stroke-opacity=".48"/>
        <circle cx="156" cy="240" r="7" fill="#EC937B"/><circle cx="483" cy="224" r="7" fill="#D4EC96"/>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">1 V 1 / ELECTRUM ZONE</span>
    </>
  )}
  {variant === 'takstrid' && (
    <>
      <span class="visual-topline" aria-hidden="true">TAK / AUDIO_WORLD</span>
      <svg class="visual-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="takstrid-fog">
            <stop offset="0" stop-color="#506678" stop-opacity=".55"/>
            <stop offset="1" stop-color="#192936" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <ellipse cx="330" cy="195" rx="230" ry="165" fill="url(#takstrid-fog)"/>
        <path d="M70 370L203 170M570 370L437 170" stroke="#7A9DA5" stroke-width="2" stroke-opacity=".4"/>
        <path d="M106 370L241 178M530 370L399 178" stroke="#71929A" stroke-opacity=".28"/>
        <g stroke="#A1E8D1" stroke-width="2" stroke-opacity=".6">
          <circle cx="320" cy="206" r="48"/>
          <circle cx="320" cy="206" r="90" stroke-dasharray="5 9"/>
          <circle cx="320" cy="206" r="137" stroke-opacity=".45"/>
          <circle cx="320" cy="206" r="182" stroke-opacity=".24"/>
        </g>
        <path d="M60 209h68l17-25 18 48 20-75 18 90 18-55 15 17h48" stroke="#C7FDE1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M375 206h43l14-32 20 60 15-82 22 100 18-47h70" stroke="#C7FDE1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".8"/>
        <circle cx="320" cy="206" r="14" fill="#9CEFC9"/>
        <path d="M306 206q14-25 28 0q-14 25-28 0Z" fill="#20313A"/>
        <path d="M318 185l2-48m-2 90 2 48m-24-69h-45m92 0h44" stroke="#DCF7E2" stroke-width="1.5" stroke-opacity=".5"/>
        <g font-family="monospace" fill="#BCEAD4" font-size="12" letter-spacing="2">
          <text x="74" y="86">DIRECTIONAL AUDIO</text>
          <text x="467" y="318">NO VISUAL HUD</text>
        </g>
        <g fill="#91C3A9" opacity=".65">
          <circle cx="146" cy="110" r="3"/><circle cx="472" cy="97" r="4"/><circle cx="546" cy="271" r="3"/>
        </g>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">LISTEN → ORIENT → SURVIVE</span>
    </>
  )}
  {variant === 'farmlore' && (
    <>
      <span class="visual-topline" aria-hidden="true">GF / DARK_FOREST</span>
      <svg class="visual-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges">
        <path d="M0 342l112-117 91 60 117-163 102 126 89-62 129 132v82H0Z" fill="#293D44"/>
        <path d="M0 371l154-109 89 49 114-125 91 78 98-59 94 124v71H0Z" fill="#385449"/>
        <g fill="#1A3336">
          <path d="M70 263l26-99 26 99ZM113 269l29-121 29 121ZM496 247l26-95 26 95ZM538 272l34-136 34 136Z"/>
        </g>
        <path d="M136 331l68-102 75 10 53 92Z" fill="#4B443F"/>
        <path d="M125 238l111-100 113 100Z" fill="#A26358" stroke="#D8A280" stroke-width="4"/>
        <rect x="159" y="239" width="162" height="92" fill="#6F5543" stroke="#AA8C6B" stroke-width="3"/>
        <rect x="213" y="268" width="54" height="63" fill="#283E42" stroke="#D7AB85" stroke-width="3"/>
        <path d="M325 330h315" stroke="#7A9C68" stroke-width="9"/>
        <g fill="#607749" stroke="#9ABC6C" stroke-width="4">
          <rect x="28" y="310" width="84" height="33"/>
          <rect x="352" y="309" width="74" height="34"/>
          <rect x="448" y="309" width="64" height="34"/>
        </g>
        <g stroke="#B1C977" stroke-width="4">
          <path d="M47 321v-27m15 29v-25m19 25v-29m18 29v-20"/>
          <path d="M369 323v-25m20 25v-24m20 24v-27"/>
          <path d="M467 321v-25m23 25v-24"/>
        </g>
        <g>
          <rect x="395" y="271" width="18" height="26" fill="#DFD3AC"/>
          <rect x="391" y="259" width="26" height="17" fill="#93B3A3"/>
          <rect x="398" y="291" width="6" height="16" fill="#282E33"/>
          <rect x="408" y="291" width="6" height="16" fill="#282E33"/>
          <rect x="535" y="291" width="27" height="23" rx="4" fill="#8FD09E" stroke="#C6F4A6" stroke-width="3"/>
          <circle cx="543" cy="302" r="3" fill="#223A36"/><circle cx="555" cy="302" r="3" fill="#223A36"/>
        </g>
        <g font-family="monospace" fill="#BFE0BB" font-size="12" letter-spacing="2">
          <text x="63" y="83">VILLAGE / QUESTS</text><text x="449" y="113">FOREST / COMBAT</text>
        </g>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">FARM → EXPLORE → UNCOVER</span>
    </>
  )}
  {variant === 'frog' && (
    <>
      <span class="visual-topline" aria-hidden="true">NF / PLATFORMING</span>
      <svg class="visual-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <circle cx="505" cy="82" r="47" fill="#b3d99d" fill-opacity=".23"/>
        <path d="M0 288L110 181 189 259 305 166 434 251 546 176 640 244V400H0Z" fill="#35544f"/>
        <path d="M0 335L98 261 221 308 329 234 443 281 530 220 640 311V400H0Z" fill="#27433b"/>
        <g fill="#648f63" stroke="#d0ed99" stroke-width="3"><rect x="0" y="306" width="165" height="25"/><rect x="247" y="255" width="150" height="25"/><rect x="480" y="307" width="160" height="25"/></g>
        <g fill="#2e4a39"><rect x="0" y="331" width="165" height="69"/><rect x="247" y="280" width="150" height="120"/><rect x="480" y="332" width="160" height="68"/></g>
        <path d="M358 211L498 92" stroke="#d8f1bd" stroke-width="3" stroke-dasharray="6 7"/>
        <g transform="translate(307 184)">
          <ellipse cx="40" cy="43" rx="35" ry="29" fill="#7dbd5c" stroke="#c8ef8e" stroke-width="4"/>
          <circle cx="20" cy="14" r="12" fill="#83c25d" stroke="#c8ef8e" stroke-width="3"/><circle cx="60" cy="14" r="12" fill="#83c25d" stroke="#c8ef8e" stroke-width="3"/>
          <circle cx="20" cy="14" r="5" fill="#1b3330"/><circle cx="60" cy="14" r="5" fill="#1b3330"/>
          <path d="M8 34l65-4" stroke="#243b45" stroke-width="11"/><path d="M17 61l-13 19m58-19 14 19" stroke="#a3d976" stroke-width="8" stroke-linecap="round"/>
        </g>
        <path d="M190 307l19-35 19 35zm239 0 17-29 17 29z" fill="#efb984" stroke="#fce4b4" stroke-width="2"/>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">JUMP → GRAPPLE → EXPLORE</span>
    </>
  )}
  {variant === 'tictactoe' && (
    <>
      <span class="visual-topline" aria-hidden="true">TTT / BOARD_STATE</span>
      <svg class="visual-svg tictactoe-svg" viewBox="0 0 640 400" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <g fill="#F5F9FF" opacity=".6">
          <circle cx="61" cy="74" r="2"/><circle cx="133" cy="298" r="2"/><circle cx="555" cy="72" r="1.8"/>
          <circle cx="535" cy="314" r="2"/><circle cx="430" cy="64" r="2"/><circle cx="207" cy="112" r="1.7"/>
          <circle cx="477" cy="353" r="2"/><circle cx="78" cy="200" r="1.5"/>
        </g>
        <g transform="translate(194 74) rotate(-7 125 125)">
          <rect x="0" y="0" width="250" height="250" rx="22" fill="#15273E" stroke="#80BDF1" stroke-opacity=".5"/>
          <path d="M83 18v214M166 18v214M18 83h214M18 166h214" stroke="#85BAE0" stroke-width="2.5" stroke-opacity=".7"/>
          <g stroke="#BBEAF3" stroke-width="7" stroke-linecap="round">
            <path d="M31 31l35 35M66 31L31 66"/>
            <path d="M115 115l36 36M151 115l-36 36"/>
            <path d="M31 199l35 35M66 199l-35 35"/>
          </g>
          <g stroke="#E7B8FF" stroke-width="7">
            <circle cx="125" cy="42" r="20"/><circle cx="209" cy="125" r="20"/><circle cx="209" cy="209" r="20"/>
          </g>
        </g>
        <path d="M88 285l22-14 23 14-23 15zM520 133l16-10 16 10-16 9z" fill="#D6E4FF" fill-opacity=".28"/>
      </svg>
      <span class="visual-bottomline" aria-hidden="true">PLAYER_01 / YOUR_MOVE</span>
    </>
  )}

</div>
